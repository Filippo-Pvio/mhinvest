---
import Hero from '../components/Hero.astro';
import site from '../content/site.json';
import '../styles/global.css';
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="robots" content="noindex, nofollow, noarchive" />
    <meta name="theme-color" content="#151715" />
    <meta name="description" content="Akquise-Konzept für MH-Invest GmbH: persönliche Beratung zu Versicherungen, Finanzen und Investment in Hagen." />
    <title>MH-Invest | Akquise-Hero Konzept</title>
  </head>
  <body id="top">
    <a class="skip-link" href="#content">Zum Inhalt</a>
    <aside class="demo-notice" aria-label="Hinweis zur Präsentationsdemo">
      Akquise-Demo · KI-generiertes Konzeptmotiv · nicht zur Veröffentlichung
    </aside>
    <Hero />

    <main id="content">
      <section class="intro-section reveal-block" id="profil" aria-labelledby="profil-title">
        <div class="intro-heading">
          <p class="section-kicker">Persönliche Beratung</p>
          <h2 id="profil-title">Ihre Finanzthemen sind persönlich. Die Beratung auch.</h2>
        </div>
        <div class="intro-body">
          <p class="section-lead"><strong>„Ich bin für Sie da, wenn aus vielen Möglichkeiten eine klare Entscheidung werden soll.“</strong><br />Marius Hryn verbindet bei MH-Invest persönliche Beratung mit digitalen Vergleichsmöglichkeiten.</p>
          <ul class="profile-facts" aria-label="Merkmale von MH-Invest">
            {site.trust.map((item) => <li><span>{item.label}</span><strong>{item.value}</strong></li>)}
          </ul>
        </div>
      </section>

      <section class="services reveal-block" id="leistungen" aria-labelledby="services-title">
        <div class="section-heading">
          <p class="section-kicker">Leistungsfelder</p>
          <h2 id="services-title">Was möchten Sie heute besser einordnen?</h2>
        </div>
        <div class="service-list">
          {site.services.map((service) => (
            <article id={service.id}><span>{service.number}</span><h3>{service.title}</h3><p>{service.description}</p></article>
          ))}
        </div>
      </section>

      <section class="why-section reveal-block" aria-labelledby="why-title">
        <div class="why-heading">
          <p class="section-kicker">Warum MH-Invest?</p>
          <h2 id="why-title">Beratung, die nicht bei der Auswahl aufhört.</h2>
        </div>
        <div class="why-list">
          <article><span>01</span><h3>Persönlich beraten</h3><p>Ihre Situation und Ihre Ziele geben die Richtung vor – nicht ein Produktkatalog.</p></article>
          <article><span>02</span><h3>Am Markt vergleichen</h3><p>Relevante Möglichkeiten werden gegenübergestellt und verständlich eingeordnet.</p></article>
          <article><span>03</span><h3>Bei der Umsetzung begleiten</h3><p>Nach der Entscheidung bleiben die nächsten Schritte nachvollziehbar und begleitet.</p></article>
        </div>
      </section>

      <section class="process-section reveal-block" id="beratungsweg" aria-labelledby="process-title">
        <div class="process-intro">
          <p class="section-kicker">So läuft die Beratung</p>
          <h2 id="process-title">Von Ihrer Situation zu einer klaren Entscheidung.</h2>
          <p>„Innovative Finanzdiagnostik“ bedeutet hier: Ihre Ausgangslage strukturiert betrachten, Möglichkeiten vergleichen und die nächsten Schritte verständlich einordnen.</p>
        </div>
        <ol class="process-list">
          {site.process.map((step) => (
            <li class="process-step">
              <span>{step.number}</span>
              <div><h3>{step.title}</h3><p>{step.description}</p></div>
            </li>
          ))}
        </ol>
      </section>

      <section class="utility-section reveal-block" id="vergleichen" aria-labelledby="utility-title">
        <div class="utility-copy">
          <p class="section-kicker">Digitale Ergänzung</p>
          <h2 id="utility-title">Digital vergleichen. Persönlich entscheiden.</h2>
        </div>
        <div class="utility-detail">
          <p>Für ausgewählte Versicherungs-, Finanz- und Alltagsthemen können Sie Angebote digital vergleichen. Wenn Sie Unterstützung bei der Einordnung möchten, bleibt die Beratung persönlich.</p>
          <a href={site.comparisonHref} target="_blank" rel="noreferrer">Vergleichsmöglichkeiten öffnen <span aria-hidden="true">↗</span></a>
        </div>
      </section>

      <section class="contact-section reveal-block" id="kontakt" aria-labelledby="contact-title">
        <div class="contact-copy">
          <p class="section-kicker">Persönliches Gespräch</p>
          <h2 id="contact-title">Worum geht es bei Ihnen?</h2>
          <p>Schreiben Sie kurz, was Sie beschäftigt. So kann sich MH-Invest gezielt auf Ihr Anliegen vorbereiten und persönlich bei Ihnen melden.</p>
        </div>
        <form class="contact-form" id="contact-form">
          <label>Ihr Name<input name="name" autocomplete="name" required /></label>
          <label>E-Mail<input name="email" type="email" autocomplete="email" required /></label>
          <label>Telefon <span class="optional">optional</span><input name="telefon" type="tel" autocomplete="tel" /></label>
          <label>Worum geht es?
            <select name="thema" required>
              <option value="">Bitte auswählen</option>
              <option>Versicherungen</option><option>Vorsorge</option><option>Finanzierung</option><option>Investment</option><option>Ich bin mir noch nicht sicher</option>
            </select>
          </label>
          <label>Ihre Nachricht <span class="optional">optional</span><textarea name="nachricht" rows="3" placeholder="Was dürfen wir vorab wissen?"></textarea></label>
          <label class="consent"><input type="checkbox" required /><span>Ich stimme zu, dass meine Angaben zur Kontaktaufnahme verwendet werden. Für eine reale Website wäre die finale Datenschutzerklärung verbindlich zu verknüpfen.</span></label>
          <button class="form-submit" type="submit">Gespräch anfragen <span aria-hidden="true">↗</span></button>
          <p class="form-note">Konzeptdemo: Das Formular versendet keine Daten.</p>
          <p class="form-status" role="status" aria-live="polite"></p>
          <div class="contact-alternatives" aria-label="Alternative Kontaktmöglichkeiten">
            <span>Lieber direkt?</span>
            <a href={site.phoneHref}>{site.phone}</a>
            <a href={site.emailHref}>{site.email}</a>
          </div>
        </form>
      </section>
    </main>

    <footer>
      <p>MH-Invest GmbH · {site.address} · Akquise-Konzept</p>
      <nav aria-label="Rechtliche Informationen">
        {site.legalLinks.map((link) => <a href={link.href} target="_blank" rel="noreferrer">{link.label}</a>)}
      </nav>
      <a href="#top">Nach oben ↑</a>
    </footer>

    <script>
      const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)');
      const hero = document.querySelector<HTMLElement>('.hero');
      const processSection = document.querySelector<HTMLElement>('.process-section');
      const processList = document.querySelector<HTMLElement>('.process-list');
      const processSteps = [...document.querySelectorAll<HTMLElement>('.process-step')];
      let motionFrame = 0;

      const clamp = (value: number) => Math.min(1, Math.max(0, value));

      const updateMotion = () => {
        motionFrame = 0;
        if (reducedMotion.matches) return;

        if (hero) {
          const heroRect = hero.getBoundingClientRect();
          const heroProgress = clamp(-heroRect.top / Math.max(heroRect.height, 1));
          hero.style.setProperty('--hero-shift', (heroProgress * 2.4).toFixed(3) + '%');
        }

        if (processSection && processList && processSteps.length) {
          const sectionRect = processSection.getBoundingClientRect();
          const travel = Math.max(sectionRect.height - innerHeight * .32, 1);
          const progress = clamp((innerHeight * .62 - sectionRect.top) / travel);
          processList.style.setProperty('--diagnostic-progress', progress.toFixed(4));

          let currentStep = 0;
          processSteps.forEach((step, index) => {
            if (step.getBoundingClientRect().top < innerHeight * .62) currentStep = index;
          });
          processSteps.forEach((step, index) => {
            step.classList.toggle('is-complete', index < currentStep);
            step.classList.toggle('is-current', index === currentStep);
          });
        }
      };

      const requestMotionUpdate = () => {
        if (!motionFrame) motionFrame = requestAnimationFrame(updateMotion);
      };

      if (!reducedMotion.matches) {
        document.documentElement.classList.add('motion-ready');
        addEventListener('scroll', requestMotionUpdate, { passive: true });
        addEventListener('resize', requestMotionUpdate);
        updateMotion();
      }

      const contactForm = document.querySelector<HTMLFormElement>('#contact-form');
      contactForm?.addEventListener('submit', (event) => {
        event.preventDefault();
        const status = contactForm.querySelector<HTMLElement>('.form-status');
        if (status) status.textContent = 'Danke. In der Konzeptdemo werden keine Daten versendet.';
      });
    </script>
  </body>
</html>
